#!/bin/bash
# Run Oolong benchmark for all models on both synth and real datasets
# Usage: ./run_oolong_all.sh [--limit N] [--output_path PATH] [--max_parallel N]

set -e


# Default values
LIMIT=""
OUTPUT_BASE="/home/jiaruil5/proxy_bench/proxy_bench_data/oolong"
MAX_PARALLEL=4  # Limit concurrent jobs to avoid rate limits

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --limit)
            LIMIT="--limit $2"
            shift 2
            ;;
        --output_path)
            OUTPUT_BASE="$2"
            shift 2
            ;;
        --max_parallel)
            MAX_PARALLEL="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

models=(
  "azure/gpt-4o"
  "azure/gpt-5"
  "azure/o3"
  "azure/o4-mini"
  "azure/gpt-oss-120b"
  "gemini/gemini-2.0-flash"
  "gemini/gemini-2.5-flash"
  "gemini/gemini-2.5-pro"
  "gemini/gemini-3-pro-preview"
  "gemini/gemini-3-flash-preview"
  "neulab/claude-opus-4-5-20251101"
  "neulab/claude-sonnet-4-5-20250929"
  "neulab/claude-sonnet-4-20250514"
  "neulab/kimi-k2-0711-preview"
  "azure/Llama-4-Maverick-17B-128E-Instruct-FP8"
  # "neulab/qwen3-coder-480b-a35b-instruct"
)

datasets=("synth" "real")

echo "Running Oolong benchmark for ${#models[@]} models on ${#datasets[@]} datasets..."
echo "Output base: ${OUTPUT_BASE}"
echo "Max parallel jobs: ${MAX_PARALLEL}"
echo ""

for dataset in "${datasets[@]}"; do
  echo "=========================================="
  echo "Dataset: ${dataset}"
  echo "=========================================="

  running=0
  for model in "${models[@]}"; do
    (
      # Set max_tokens based on model
      if [[ "$model" == "azure/gpt-4o" ]]; then
        MAX_TOKENS=16384
      else
        MAX_TOKENS=32768
      fi

      echo "Starting: ${model} on ${dataset} (max_tokens=${MAX_TOKENS})"
      python run_oolong.py \
        --model "$model" \
        --dataset "$dataset" \
        --output_path "${OUTPUT_BASE}/${dataset}" \
        --apply_chat_template \
        --log_samples \
        --max_tokens $MAX_TOKENS \
        $LIMIT
      echo "Completed: ${model} on ${dataset}"
    ) &

    # Limit parallel jobs
    ((++running))
    if [[ $running -ge $MAX_PARALLEL ]]; then
      wait -n || true  # Wait for any one job to finish, ignore failures
      ((running--)) || true
    fi
  done

  # Wait for remaining jobs to complete
  wait || true
  echo "Completed all models for dataset: ${dataset}"
  echo ""
done

echo "All Oolong evaluations completed."
