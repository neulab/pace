# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# ── Virtual environments ─────────────────────────────────────────────
venv/
.venv/
env/
.bfcl-venv/
evaluations/.bfcl-venv/

# ── OS / editor cruft ────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ── Secrets (never commit real credentials) ──────────────────────────
# keys.json holds LeetCode cookies for debugbench; use keys.example.json as a
# template and create keys.json locally. The handler skips OJ grading if absent.
evaluations/benchmarks/debugbench/evaluation/keys.json
.env
*.key

# ── Large data NOT suitable for GitHub ───────────────────────────────
# raw_results is ~15 GB of full per-model outputs (host it separately, e.g.
# HF Datasets / Zenodo). standardized_results (56 MB) IS tracked — it is the
# input pacebench reads. NOTE: planbench needs raw_results/planbench; obtain it
# from the data host to run planbench.
results/raw_results/

# ── Generated outputs / run artifacts ────────────────────────────────
/abs_predictions.csv
/pair_predictions.csv
/abs_predictions_split.csv
/pair_predictions_split.csv
/abs_fit_all_predictions.csv
/pair_fit_all_predictions.csv
/abs_loocv_fit.png
/pair_loocv_scatter.png
*.log
eval_plan.csv
found_plans/
# per-fold LOOCV selection dumps (regenerate with cli.py --dump-selections);
# the reference in-sample selection (selections/abs_fit/) is kept.
scripts/pacebench/selections/abs_loocv/
scripts/pacebench/selections/pair_loocv_pinA/
scripts/pacebench/selections/*_split/

# ── HuggingFace / model caches ───────────────────────────────────────
.cache/

# Claude Code session dir
.claude/
