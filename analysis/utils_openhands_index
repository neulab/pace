# Supported OpenHands index benchmarks
SUPPORTED_BENCHMARKS = [
    "commit0",
    "gaia",
    "swe-bench",
    "swt-bench",
    "swe-bench-multimodal",
]


# Mapping from OpenHands index model directory names -> canonical names used by LCB/MMLU utils
# Only include mappings we are confident about; unknown models will be skipped gracefully
OPENHANDS_TO_CANON_FOR_LCB: Dict[str, str] = {
    # Gemini
    "Gemini-3-Flash": "Gemini-2.5-Flash",
    "Gemini-3-Pro": "Gemini-3-Pro-Preview",

    # GPT family
    "GPT-5.2": "GPT-5__high",
    "GPT-5.2-Codex": "GPT-5__high",

    # Kimi
    "Kimi-K2.5": "Kimi-K2-Instruct",
    "Kimi-K2-Thinking": "Kimi-K2-Instruct",

    # Claude
    "claude-opus-4-6": "Claude-Opus-4.5",
    "claude-opus-4-5": "Claude-Opus-4.5",
    "claude-sonnet-4-5": "Claude-Sonnet-4.5",

    # Qwen
    "Qwen3-Coder-480B": "Qwen3-Coder-480B-A35B-Instruct",
}


OPENHANDS_TO_CANON_FOR_MMLU: Dict[str, str] = {
    # MMLU utils mapping currently includes these canonical names
    "claude-sonnet-4-5": "Claude-Sonnet-4.5",
    "Qwen3-Coder-480B": "Qwen3-Coder-480B-A35B-Instruct",
    # Note: GPT-5.2 is not present in default MMLU mapping; if available, add here
}


def load_openhands_index_scores(results_dir: str, benchmark: str) -> Dict[str, float]:
    """
    Load model-level scores for a given benchmark from OpenHands index results.

    Args:
        results_dir: path like openhands-index-results/results
        benchmark: one of SUPPORTED_BENCHMARKS

    Returns:
        dict: {model_dir_name: score}
    """
    if benchmark not in SUPPORTED_BENCHMARKS:
        raise ValueError(f"Unsupported benchmark '{benchmark}'. Choose from {SUPPORTED_BENCHMARKS}")

    out: Dict[str, float] = {}
    if not os.path.isdir(results_dir):
        return out

    for model in sorted(os.listdir(results_dir)):
        model_dir = os.path.join(results_dir, model)
        if not os.path.isdir(model_dir):
            continue
        fpath = os.path.join(model_dir, "scores.json")
        if not os.path.exists(fpath):
            continue
        try:
            with open(fpath, "r") as f:
                entries = json.load(f)
        except Exception:
            continue

        # Find the entry with the specified benchmark. Use the first match.
        for e in entries:
            if e.get("benchmark") == benchmark:
                # Use the top-level "score" as provided
                score = e.get("score")
                if score is not None:
                    try:
                        out[model] = float(score)
                    except Exception:
                        pass
                break

    return out


def _aggregate_utils_scores(dicts: List[Dict[str, float]]) -> List[float]:
    """Aggregate per-item dicts into a single model-level score via simple mean."""
    agg: List[float] = []
    for d in dicts:
        if not d:
            agg.append(float("nan"))
            continue
        vals = [float(v) for v in d.values()]
        agg.append(float(np.mean(vals)))
    return agg


def _load_lcb_aggregates(
    canonical_models: List[str],
    lcb_dir: Optional[str] = None,
    lcb_task: str = "codegeneration",
) -> Dict[str, float]:
    """
    Load LCB per-item outputs for the provided canonical model list and aggregate by mean.

    Returns: {canonical_model: aggregate_score}
    """
    kept, dicts = _utils_lcb.load_model_outputs_for_models(
        canonical_models,
        task=lcb_task,
        lcb_dir=lcb_dir or _utils_lcb.DEFAULT_LCB_DIR,
    )
    aggs = _aggregate_utils_scores(dicts)
    return {m: a for m, a in zip(kept, aggs) if a == a}  # filter NaNs


def _load_mmlu_aggregates(
    canonical_models: List[str],
    mmlu_dir: Optional[str] = None,
    mmlu_task: str = "mmlu_electrical_engineering",
) -> Dict[str, float]:
    """
    Load MMLU per-item outputs for the provided canonical model list and aggregate by mean.

    Returns: {canonical_model: aggregate_score}
    """
    kept, dicts = _utils_mmlu.load_model_outputs_for_models(
        canonical_models,
        mmlu_dir=mmlu_dir or _utils_mmlu.DEFAULT_MMLU_BASE_DIR,
        mmlu_task=mmlu_task,
    )
    aggs = _aggregate_utils_scores(dicts)
    return {m: a for m, a in zip(kept, aggs) if a == a}


def _build_xy(
    oh_scores: Dict[str, float],
    source: str,
    lcb_dir: Optional[str] = None,
    lcb_task: str = "codegeneration",
    mmlu_dir: Optional[str] = None,
    mmlu_task: str = "mmlu_electrical_engineering",
) -> Tuple[List[float], List[float], List[str]]:
    """
    Build aligned x/y arrays for correlation.

    x: source benchmark aggregates (lcb or mmlu)
    y: OpenHands index benchmark scores

    Returns: (xs, ys, labels)
    """
    assert source in ("lcb", "mmlu"), "source must be 'lcb' or 'mmlu'"

    if source == "lcb":
        name_map = OPENHANDS_TO_CANON_FOR_LCB
        canon_candidates = sorted(set([name_map[m] for m in oh_scores.keys() if m in name_map]))
        canon_to_val = _load_lcb_aggregates(canon_candidates, lcb_dir=lcb_dir, lcb_task=lcb_task)
    else:
        name_map = OPENHANDS_TO_CANON_FOR_MMLU
        canon_candidates = sorted(set([name_map[m] for m in oh_scores.keys() if m in name_map]))
        canon_to_val = _load_mmlu_aggregates(canon_candidates, mmlu_dir=mmlu_dir, mmlu_task=mmlu_task)

    xs: List[float] = []
    ys: List[float] = []
    labels: List[str] = []

    for oh_name, y in sorted(oh_scores.items()):
        canon = name_map.get(oh_name)
        if canon is None:
            continue
        x = canon_to_val.get(canon)
        if x is None:
            continue
        xs.append(float(x))
        ys.append(float(y))
        labels.append(oh_name)

    return xs, ys, labels


def compute_and_plot(
    xs: List[float],
    ys: List[float],
    labels: List[str],
    title: str,
    x_label: str,
    y_label: str,
    out_path: Optional[str] = None,
    annotate: bool = True,
) -> Dict[str, float]:
    """
    Compute correlations, fit a linear model, and produce a scatter + fit plot with 1-sigma band.

    Returns a dict summary of stats.
    """
    if len(xs) < 2:
        raise RuntimeError("Need at least 2 points to compute correlation and fit.")

    x = np.asarray(xs, dtype=float)
    y = np.asarray(ys, dtype=float)

    pearson_r, pearson_p = pearsonr(x, y)
    spearman_r, spearman_p = spearmanr(x, y)

    # Linear fit y = m x + b
    m, b = np.polyfit(x, y, 1)
    y_fit = m * x + b
    resid = y - y_fit
    sigma = float(np.std(resid, ddof=1)) if len(x) > 2 else float(np.std(resid))

    # Plot
    plt.figure(figsize=(7.5, 5.5))
    plt.scatter(x, y, s=50, alpha=0.85, edgecolors="k")

    # Fit line and 1-std band
    grid_x = np.linspace(float(np.min(x)), float(np.max(x)), 200)
    grid_y = m * grid_x + b
    plt.plot(grid_x, grid_y, color="tab:red", linewidth=2, label="Linear fit")
    plt.fill_between(grid_x, grid_y - sigma, grid_y + sigma, color="tab:red", alpha=0.15, label=r"±1σ")

    if annotate:
        for xi, yi, lab in zip(x, y, labels):
            plt.annotate(lab, (xi, yi), textcoords="offset points", xytext=(5, 5), fontsize=8)

    plt.title(
        f"{title}\nPearson r={pearson_r:.3f} (p={pearson_p:.2g}); Spearman ρ={spearman_r:.3f} (p={spearman_p:.2g})"
    )
    plt.xlabel(x_label)
    plt.ylabel(y_label)
    plt.grid(True, linestyle=":", linewidth=0.6, alpha=0.6)
    plt.legend(frameon=False)
    plt.tight_layout()

    if out_path:
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        plt.savefig(out_path, dpi=200)
    else:
        plt.show()
    plt.close()

    return {
        "pearson_r": float(pearson_r),
        "pearson_p": float(pearson_p),
        "spearman_r": float(spearman_r),
        "spearman_p": float(spearman_p),
        "slope": float(m),
        "intercept": float(b),
        "residual_std": float(sigma),
        "n_points": int(len(x)),
    }


def run(
    benchmark: str,
    source: str = "lcb",
    results_dir: Optional[str] = None,
    # LCB params
    lcb_dir: Optional[str] = None,
    lcb_task: str = "codegeneration",
    # MMLU params
    mmlu_dir: Optional[str] = None,
    mmlu_task: str = "mmlu_electrical_engineering",
    out_path: Optional[str] = None,
    annotate: bool = True,
) -> Dict[str, float]:
    """
    End-to-end routine:
      - Load OpenHands index scores for the given benchmark as y
      - Load/aggregate LCB or MMLU per-model scores as x (using utils_lcb or utils_mmlu)
      - Align models and produce correlation + fit plot

    Returns stats dict from compute_and_plot.
    """
    results_dir = results_dir or DEFAULT_RESULTS_DIR
    source = source.lower()
    if source not in ("lcb", "mmlu"):
        raise ValueError("source must be 'lcb' or 'mmlu'")
    if benchmark not in SUPPORTED_BENCHMARKS:
        raise ValueError(f"Unsupported benchmark '{benchmark}'. Choose from {SUPPORTED_BENCHMARKS}")

    oh_scores = load_openhands_index_scores(results_dir, benchmark)
    if not oh_scores:
        raise RuntimeError(f"No OpenHands index scores found under {results_dir} for benchmark '{benchmark}'")

    xs, ys, labels = _build_xy(
        oh_scores,
        source=source,
        lcb_dir=lcb_dir,
        lcb_task=lcb_task,
        mmlu_dir=mmlu_dir,
        mmlu_task=mmlu_task,
    )

    if len(xs) < 2:
        raise RuntimeError(
            f"Insufficient overlap between OpenHands models and {source.upper()} canonical models (need >=2, got {len(xs)}).\n"
            f"OpenHands models: {sorted(list(oh_scores.keys()))}\n"
            f"Try adding/adjusting OPENHANDS_TO_CANON_FOR_{source.upper()} mappings or verifying data directories."
        )

    title = f"OpenHands-Index vs {source.upper()} — {benchmark}"
    x_label = f"{source.upper()} aggregate (mean per-item)"
    y_label = f"OpenHands {benchmark} score"

    if out_path is None:
        out_dir = os.path.join(os.path.dirname(__file__), "plots", f"openhands_vs_{source}")
        out_path = os.path.join(out_dir, f"{benchmark}.png")

    return compute_and_plot(
        xs, ys, labels,
        title=title,
        x_label=x_label,
        y_label=y_label,
        out_path=out_path,
        annotate=annotate,
    )


