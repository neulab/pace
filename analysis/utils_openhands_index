    parser.add_argument("--benchmark", required=True, choices=SUPPORTED_BENCHMARKS, help="Target benchmark for y-axis (OpenHands index)")
    parser.add_argument("--source", default="lcb", choices=["lcb", "mmlu"], help="Source for x-axis aggregate")
    parser.add_argument("--results_dir", default=DEFAULT_RESULTS_DIR, help="Path to openhands-index-results/results")

    # LCB opts
    parser.add_argument("--lcb_dir", default=_utils_lcb.DEFAULT_LCB_DIR, help="Base directory containing LCB outputs")
    parser.add_argument("--lcb_task", default="codegeneration", choices=["codegeneration", "codeexecution", "selfrepair", "testoutputprediction"], help="LCB task to use")

    # MMLU opts
    parser.add_argument("--mmlu_dir", default=_utils_mmlu.DEFAULT_MMLU_BASE_DIR, help="Base directory containing MMLU task folders")
    parser.add_argument("--mmlu_task", default="mmlu_electrical_engineering", help="MMLU task folder name (e.g., mmlu_anatomy)")

    parser.add_argument("--out", default=None, help="Optional output image path (.png). If not set, writes to analysis/plots/")
    parser.add_argument("--no_annotate", action="store_true", help="Disable point annotations")

    args = parser.parse_args()

    try:
        stats = run(
            benchmark=args.benchmark,
            source=args.source,
            results_dir=args.results_dir,
            lcb_dir=args.lcb_dir,
            lcb_task=args.lcb_task,
            mmlu_dir=args.mmlu_dir,
            mmlu_task=args.mmlu_task,
            out_path=args.out,
            annotate=(not args.no_annotate),
        )
        print(json.dumps(stats, indent=2))
    except Exception as e:
        # Print a readable error (helpful when data directories are not present)
        print(f"ERROR: {e}")
        raise
