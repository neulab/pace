# ---------------------------------------------------------------------------
# Credentials template for running models (Part 2 of the README).
#
# HOW TO USE:
#   1. Copy this file to `.env` in the same folder:   cp .env.example .env
#   2. Open `.env` and fill in your real API key after `API_KEY=`.
#
# `.env` is git-ignored, so your key stays local and is never committed.
# The evaluations entry points (run.py, score_new_model.py) auto-load `.env`.
# ---------------------------------------------------------------------------

# REQUIRED — your key for the OpenAI-compatible endpoint (looks like sk-...).
API_KEY=

# The endpoint URL. Keep this default unless you use a different provider.
BASE_URL=https://cmu.litellm.ai

# Leave as 0 unless you installed the optional `hf_transfer` package.
HF_HUB_ENABLE_HF_TRANSFER=0
