      "doc_to_target": "def doc_to_target(doc) -> str:\n    \"\"\"\n    Convert the label to (A), (B), (C), (D) format.\n    \"\"\"\n    label_map = {\"a\": \"(A)\", \"b\": \"(B)\", \"c\": \"(C)\", \"d\": \"(D)\"}\n    return label_map[doc[\"label\"].strip().lower()]\n",
